# =============================================================================
# .gitignore: hospital analytics
# =============================================================================
# Committed      data/raw/*.csv   the 16 MB Synthea source extract, so the
#                                database can be rebuilt from source
#                scripts/, notebooks/, figures/, outputs/
#                README.md, requirements.txt, LICENSE
#
# Not committed  data/hospital.db  a build artifact; scripts/build_db.py
#                                  recreates it in about 30 seconds
#                local environments, caches, workspace files
# =============================================================================


# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
.python-version


# --- Jupyter ----------------------------------------------------------------
# Notebook outputs are committed on purpose (so the notebook reads without a
# runtime), but checkpoints and execution copies are not.
.ipynb_checkpoints/
*.nbconvert.ipynb
jupyter_execute/


# --- Built database ---------------------------------------------------------
# Generated by scripts/build_db.py from data/raw/*.csv. Committing it would put a
# 25 MB binary in history to save a reviewer one command.
data/hospital.db
*.sqlite
*.sqlite3


# --- Local workspace --------------------------------------------------------
notes/
scratch/
NOTES.md
TODO.md
*.local.md
*~$*


# --- OS and editor cruft ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
